#!/usr/bin/env python3
"""Search the shared vulnerability corpus for audit-time pattern matches."""

from __future__ import annotations

import argparse
import re
import sys
from dataclasses import dataclass
from pathlib import Path


def repo_root_from_script() -> Path:
    system_root = Path(__file__).resolve().parents[1]
    if system_root.parent.name == "designs":
        return system_root.parents[1]
    return system_root


DEFAULT_CORPUS_ROOT = repo_root_from_script() / "corpus" / "imports"


@dataclass
class CorpusEntry:
    record_path: Path
    root_card_path: Path
    code_card_path: Path
    validation_card_path: Path
    record_text: str
    root_card_text: str
    code_card_text: str
    validation_card_text: str
    fields: dict[str, object]

    @property
    def entry_id(self) -> str:
        return str(self.fields.get("id") or self.record_path.stem)

    @property
    def combined_text(self) -> str:
        return "\n".join(
            [
                self.record_text,
                self.root_card_text,
                self.code_card_text,
                self.validation_card_text,
            ]
        )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Rank normalized corpus records and retrieval cards against a query. "
            "Use the output as audit hypotheses, not as findings."
        )
    )
    parser.add_argument(
        "--corpus-root",
        default=str(DEFAULT_CORPUS_ROOT),
        help="Shared corpus import root. Defaults to the repository-level corpus/imports directory.",
    )
    parser.add_argument(
        "--query",
        action="append",
        default=[],
        help="Free-text query. Can be passed multiple times.",
    )
    parser.add_argument(
        "--query-file",
        action="append",
        default=[],
        help="Read additional query text from a file such as repo-context.md or a family scan.",
    )
    parser.add_argument(
        "--family",
        action="append",
        default=[],
        help="Restrict or boost matching to one bug_family. Can be passed multiple times.",
    )
    parser.add_argument(
        "--top-k",
        type=int,
        default=24,
        help="Maximum number of matches to print.",
    )
    parser.add_argument(
        "--output",
        help="Optional Markdown output path. Prints to stdout when omitted.",
    )
    return parser.parse_args()


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def scalar(text: str, key: str) -> str:
    match = re.search(rf"^{re.escape(key)}:\s*(.+?)\s*$", text, re.MULTILINE)
    if not match:
        return ""
    value = match.group(1).strip()
    if value.startswith("[") and value.endswith("]"):
        return value
    return value.strip("\"'")


def list_block(text: str, key: str) -> list[str]:
    match = re.search(rf"^{re.escape(key)}:\s*\n((?:\s+- .+\n?)*)", text, re.MULTILINE)
    if not match:
        return []
    items: list[str] = []
    for line in match.group(1).splitlines():
        stripped = line.strip()
        if stripped.startswith("- "):
            items.append(stripped[2:].strip().strip("\"'"))
    return items


def parse_fields(record_text: str) -> dict[str, object]:
    keys = [
        "id",
        "project",
        "bug_family",
        "bug_class",
        "subsystem",
        "confidence_tier",
        "security_verdict",
        "validated_as",
        "missing_property",
        "violated_invariant",
        "trust_boundary",
        "entrypoint_type",
        "sensitive_sink",
        "blast_radius",
        "severity_guess",
        "severity_rationale",
        "code_shape_summary",
        "patch_pattern",
    ]
    fields: dict[str, object] = {key: scalar(record_text, key) for key in keys}
    fields["recommended_uses"] = list_block(record_text, "recommended_uses")
    fields["impact_types"] = list_block(record_text, "impact_types")
    fields["search_motifs"] = list_block(record_text, "search_motifs")
    fields["negative_signals"] = list_block(record_text, "negative_signals")
    return fields


def load_entries(corpus_root: Path) -> list[CorpusEntry]:
    entries: list[CorpusEntry] = []
    for record_path in sorted(corpus_root.glob("*/records/*.yaml")):
        bundle_root = record_path.parents[1]
        entry_id = record_path.stem
        root_card_path = bundle_root / "cards" / "root-cause" / f"{entry_id}.md"
        code_card_path = bundle_root / "cards" / "code-shape" / f"{entry_id}.md"
        validation_card_path = bundle_root / "cards" / "validation" / f"{entry_id}.md"
        record_text = read_text(record_path)
        entries.append(
            CorpusEntry(
                record_path=record_path,
                root_card_path=root_card_path,
                code_card_path=code_card_path,
                validation_card_path=validation_card_path,
                record_text=record_text,
                root_card_text=read_text(root_card_path),
                code_card_text=read_text(code_card_path),
                validation_card_text=read_text(validation_card_path),
                fields=parse_fields(record_text),
            )
        )
    return entries


STOPWORDS = {
    "and",
    "are",
    "for",
    "from",
    "have",
    "into",
    "that",
    "the",
    "this",
    "with",
    "without",
    "repo",
    "file",
    "files",
    "function",
    "functions",
    "system",
}


def tokenize(text: str) -> list[str]:
    raw = re.findall(r"[a-zA-Z0-9_./:-]{3,}", text.lower())
    tokens: list[str] = []
    for token in raw:
        token = token.strip("./:-_")
        if len(token) < 3 or token in STOPWORDS:
            continue
        tokens.append(token)
    return tokens


def score_entry(entry: CorpusEntry, query_tokens: set[str], families: set[str]) -> tuple[int, list[str]]:
    fields = entry.fields
    entry_family = str(fields.get("bug_family") or "")
    if families and entry_family not in families:
        return (0, [])

    text = entry.combined_text.lower()
    matched: list[str] = []
    score = 0
    for token in query_tokens:
        occurrences = text.count(token)
        if occurrences:
            matched.append(token)
            score += min(occurrences, 5)

    for weighted_key in [
        "bug_family",
        "bug_class",
        "missing_property",
        "entrypoint_type",
        "sensitive_sink",
        "code_shape_summary",
        "patch_pattern",
    ]:
        field_tokens = set(tokenize(str(fields.get(weighted_key) or "")))
        overlap = field_tokens & query_tokens
        if overlap:
            score += 5 * len(overlap)
            matched.extend(sorted(overlap))

    uses = fields.get("recommended_uses") or []
    if isinstance(uses, list) and "retrieval_exemplar" in uses:
        score += 3
    if fields.get("confidence_tier") == "tier_a_confirmed":
        score += 2
    if families and entry_family in families:
        score += 8

    unique_matched = sorted(set(matched))
    return (score, unique_matched)


def bullet_list(items: object, fallback: str = "none recorded") -> str:
    if not isinstance(items, list) or not items:
        return f"- {fallback}"
    return "\n".join(f"- {item}" for item in items[:8])


def render_results(
    entries: list[tuple[int, CorpusEntry, list[str]]],
    query_text: str,
    families: set[str],
    corpus_root: Path,
) -> str:
    lines: list[str] = [
        "# Corpus Pattern Search Results",
        "",
        "Use these matches as hypothesis generators only. A match is not evidence of a live vulnerability.",
        "",
        "## Query",
        "",
        f"- Corpus root: `{corpus_root}`",
        f"- Families: `{', '.join(sorted(families)) if families else 'all'}`",
        f"- Query tokens: `{', '.join(sorted(set(tokenize(query_text)))[:80])}`",
        "",
        "## Matches",
        "",
    ]

    if not entries:
        lines.append("No corpus matches found for this query.")
        return "\n".join(lines).rstrip() + "\n"

    for rank, (score, entry, matched) in enumerate(entries, start=1):
        fields = entry.fields
        lines.extend(
            [
                f"### {rank}. {entry.entry_id}",
                "",
                f"- Score: `{score}`",
                f"- Project: `{fields.get('project') or ''}`",
                f"- Family: `{fields.get('bug_family') or ''}`",
                f"- Class: `{fields.get('bug_class') or ''}`",
                f"- Missing property: `{fields.get('missing_property') or ''}`",
                f"- Entrypoint: `{fields.get('entrypoint_type') or ''}`",
                f"- Sensitive sink: `{fields.get('sensitive_sink') or ''}`",
                f"- Severity guess: `{fields.get('severity_guess') or ''}`",
                f"- Matched tokens: `{', '.join(matched[:30])}`",
                f"- Record: `{entry.record_path}`",
                f"- Root-cause card: `{entry.root_card_path}`",
                f"- Code-shape card: `{entry.code_card_path}`",
                f"- Validation card: `{entry.validation_card_path}`",
                "",
                "Code-shape summary:",
                "",
                f"> {fields.get('code_shape_summary') or 'not recorded'}",
                "",
                "Search motifs:",
                "",
                bullet_list(fields.get("search_motifs")),
                "",
                "False-positive cautions:",
                "",
                bullet_list(fields.get("negative_signals")),
                "",
                "Patch pattern:",
                "",
                f"> {fields.get('patch_pattern') or 'not recorded'}",
                "",
            ]
        )
    return "\n".join(lines).rstrip() + "\n"


def main() -> int:
    args = parse_args()
    corpus_root = Path(args.corpus_root).expanduser().resolve()
    if not corpus_root.is_dir():
        print(f"Corpus root does not exist: {corpus_root}", file=sys.stderr)
        return 2

    query_chunks: list[str] = list(args.query)
    for query_file in args.query_file:
        path = Path(query_file).expanduser().resolve()
        text = read_text(path)
        if not text:
            print(f"Warning: query file was empty or unreadable: {path}", file=sys.stderr)
        query_chunks.append(text)

    if not query_chunks and not args.family:
        query_chunks.append(
            "blockchain dlt transaction execution consensus rpc p2p storage proof verifier "
            "authorization signature resource accounting state machine lifecycle fork validation"
        )

    query_text = "\n".join(query_chunks + args.family)
    query_tokens = set(tokenize(query_text))
    families = set(args.family)

    scored: list[tuple[int, CorpusEntry, list[str]]] = []
    for entry in load_entries(corpus_root):
        score, matched = score_entry(entry, query_tokens, families)
        if score > 0:
            scored.append((score, entry, matched))

    scored.sort(key=lambda item: (item[0], item[1].entry_id), reverse=True)
    output = render_results(scored[: max(args.top_k, 0)], query_text, families, corpus_root)

    if args.output:
        output_path = Path(args.output).expanduser().resolve()
        output_path.parent.mkdir(parents=True, exist_ok=True)
        output_path.write_text(output, encoding="utf-8")
    else:
        print(output, end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
