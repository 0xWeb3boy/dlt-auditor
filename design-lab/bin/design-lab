#!/usr/bin/env python3
"""Eval-driven audit design lab."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path


ROOT = Path(__file__).resolve().parents[2]
LAB_ROOT = ROOT / "design-lab"
BENCHMARKS_DIR = LAB_ROOT / "benchmarks"
RUNS_DIR = LAB_ROOT / "runs"
DESIGNS_DIR = ROOT / "designs"
LIMIT_EXHAUSTED_EXIT_CODE = 3
SERVICE_TIER_CHOICES = ("standard", "fast", "flex")
DEFAULT_SERVICE_TIER = "standard"
REASONING_EFFORT_CHOICES = ("low", "medium", "high", "xhigh")
DEFAULT_REASONING_EFFORT = "high"
DEFAULT_DEEP_REASONING_EFFORT = "xhigh"
DEFAULT_DEEP_PHASES = "canonicalize,validations,aggregate,final"
RUNNER_PHASE_CHOICES = ("all", "mapper", "corpus", "scans", "canonicalize", "validations", "aggregate", "final")


@dataclass(frozen=True)
class DesignSource:
    kind: str
    name: str
    root: Path
    loop_name: str | None = None

    @property
    def command(self) -> Path:
        return self.root / "bin" / "dlt-ai-audit-system"

    @property
    def runner(self) -> Path:
        return self.root / "bin" / "run-parallel-codex"

    @property
    def label(self) -> str:
        if self.kind == "candidate":
            return f"candidate `{self.name}` in loop `{self.loop_name}`"
        return f"design `{self.name}`"


def utc_now() -> str:
    return dt.datetime.now(dt.UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


def slugify(value: str) -> str:
    chars = []
    for ch in value.lower().strip():
        chars.append(ch if ch.isalnum() else "-")
    slug = "".join(chars)
    while "--" in slug:
        slug = slug.replace("--", "-")
    return slug.strip("-") or "benchmark"


def read_json(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def write_json(path: Path, payload: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def update_manifest(round_dir: Path, **updates: object) -> dict:
    manifest_path = round_dir / "round-manifest.json"
    manifest = read_json(manifest_path) if manifest_path.is_file() else {}
    manifest.update(updates)
    manifest["updated_at_utc"] = utc_now()
    write_json(manifest_path, manifest)
    return manifest


def design_ignore(_dir: str, names: list[str]) -> set[str]:
    return {name for name in names if name in {"runs", "__pycache__"} or name.endswith(".pyc")}


def copy_design_tree(source: Path, destination: Path, force: bool) -> None:
    source = source.resolve()
    destination = destination.resolve()
    if source == destination:
        raise SystemExit(f"Source and destination are the same design folder: {source}")
    if destination.exists():
        if not force:
            raise SystemExit(f"Destination already exists: {destination}")
        shutil.rmtree(destination)
    shutil.copytree(source, destination, ignore=design_ignore)


def command_supports_flag(command: Path, flag: str) -> bool:
    try:
        return flag in command.read_text(encoding="utf-8", errors="ignore")
    except OSError:
        return False


def resumable_runner_for_source(source_root: Path) -> Path:
    local_runner = source_root / "bin" / "run-parallel-codex"
    if (
        local_runner.is_file()
        and command_supports_flag(local_runner, "--resume")
        and command_supports_flag(local_runner, "--reasoning-effort")
        and command_supports_flag(local_runner, "--service-tier")
    ):
        return local_runner
    shared_runner = DESIGNS_DIR / "corpus-search" / "bin" / "run-parallel-codex"
    if shared_runner.is_file():
        return shared_runner
    return local_runner


def candidate_dir(loop_name: str, candidate: str) -> Path:
    return RUNS_DIR / slugify(loop_name) / "candidates" / slugify(candidate)


def load_candidate(loop_name: str, candidate: str) -> DesignSource:
    root = candidate_dir(loop_name, candidate) / "design"
    if not root.is_dir():
        raise SystemExit(f"Candidate design not found: {root}")
    source = DesignSource("candidate", slugify(candidate), root.resolve(), slugify(loop_name))
    if not source.command.is_file():
        raise SystemExit(f"Candidate command not found: {source.command}")
    return source


def load_design_source(design: str) -> DesignSource:
    root = DESIGNS_DIR / slugify(design)
    if not root.is_dir():
        raise SystemExit(f"Design not found: {root}")
    source = DesignSource("design", slugify(design), root.resolve())
    if not source.command.is_file():
        raise SystemExit(f"Design command not found: {source.command}")
    return source


def load_suite_design_source(design_root: Path, design: str) -> DesignSource:
    source = DesignSource("design", slugify(design), design_root.resolve())
    if not source.command.is_file():
        raise SystemExit(f"Suite design command not found: {source.command}")
    return source


def source_from_start_args(args: argparse.Namespace) -> DesignSource:
    if args.candidate:
        if not args.loop_name:
            raise SystemExit("--candidate requires --loop-name so the archived candidate can be found")
        return load_candidate(args.loop_name, args.candidate)
    return load_design_source(args.design)


def result_entries(ids: list[str] | None, status: str) -> list[dict]:
    return [
        {
            "ground_truth_id": value,
            "status": status,
            "title": "",
            "severity": "",
            "matched_audit_candidate_ids": [],
            "audit_evidence_files": [],
            "notes": "",
        }
        for value in (ids or [])
    ]


def entry_ids(entries: object) -> list[str]:
    ids: list[str] = []
    if not isinstance(entries, list):
        return ids
    for entry in entries:
        if isinstance(entry, dict):
            value = entry.get("ground_truth_id") or entry.get("id") or entry.get("title")
        else:
            value = entry
        if value:
            ids.append(str(value))
    return ids


def count_entries(entries: object) -> int:
    return len(entries) if isinstance(entries, list) else 0


def result_record_template(
    benchmark: dict,
    source: DesignSource,
    round_number: int,
    max_rounds: int,
    audit_run: Path,
) -> dict:
    return {
        "schema_version": 1,
        "benchmark": benchmark["name"],
        "round": round_number,
        "max_rounds": max_rounds,
        "design_source_type": source.kind,
        "design_name": source.name if source.kind == "design" else "",
        "candidate_name": source.name if source.kind == "candidate" else "",
        "candidate_loop": source.loop_name or "",
        "source_design_dir": str(source.root),
        "audit_run": str(audit_run),
        "ground_truth_dir": benchmark["ground_truth_dir"],
        "score": None,
        "score_basis": "manual root-cause/mechanism equivalence",
        "known_findings_total": None,
        "found_count": 0,
        "partial_count": 0,
        "missed_count": 0,
        "false_positive_count": 0,
        "found_findings": [],
        "partial_findings": [],
        "missed_findings": [],
        "false_positives": [],
        "duplicate_groups": [],
        "notes": "",
        "created_at_utc": utc_now(),
        "recorded_at_utc": "",
    }


def normalize_result_record(record: dict) -> dict:
    for field in ("found_findings", "partial_findings", "missed_findings", "false_positives", "duplicate_groups"):
        if not isinstance(record.get(field), list):
            record[field] = []
    record["found_count"] = count_entries(record["found_findings"])
    record["partial_count"] = count_entries(record["partial_findings"])
    record["missed_count"] = count_entries(record["missed_findings"])
    record["false_positive_count"] = count_entries(record["false_positives"])
    return record


def path_prompt_value(value: str | None, placeholder: str) -> str:
    if not value:
        return placeholder
    return str(Path(value).expanduser().resolve())


def text_prompt_value(value: str | None, placeholder: str) -> str:
    if not value:
        return placeholder
    return value


def command_learning_loop_prompt(args: argparse.Namespace) -> int:
    repo_value = path_prompt_value(args.repo, "<ABSOLUTE_PATH_TO_COMPETITION_REPO>")
    findings_value = path_prompt_value(args.findings, "<ABSOLUTE_PATH_TO_FINDINGS>")
    if args.benchmark:
        benchmark = slugify(args.benchmark)
    elif args.repo:
        benchmark = slugify(Path(args.repo).expanduser().resolve().name)
    else:
        benchmark = "<BENCHMARK_NAME>"

    loop_name = text_prompt_value(
        args.loop_name,
        f"{benchmark}-learning-loop" if benchmark != "<BENCHMARK_NAME>" else "<BENCHMARK_NAME>-learning-loop",
    )
    promoted_design = text_prompt_value(
        args.promoted_design,
        f"best-{benchmark}-audit-design" if benchmark != "<BENCHMARK_NAME>" else "best-<BENCHMARK_NAME>-audit-design",
    )
    replacements = {
        "{{SYSTEM_ROOT}}": str(ROOT),
        "{{COMPETITION_REPO}}": repo_value,
        "{{FINDINGS_PATH}}": findings_value,
        "{{BENCHMARK_NAME}}": benchmark,
        "{{LOOP_NAME}}": loop_name,
        "{{STARTING_DESIGN}}": args.starting_design,
        "{{MAX_ROUNDS}}": str(args.max_rounds),
        "{{PARALLEL_JOBS}}": str(args.parallel_jobs),
        "{{REASONING_EFFORT}}": args.reasoning_effort,
        "{{DEEP_REASONING_EFFORT}}": args.deep_reasoning_effort,
        "{{DEEP_PHASES}}": args.deep_phases,
        "{{PROMOTED_DESIGN}}": promoted_design,
        "{{SERVICE_TIER}}": args.service_tier,
    }
    template = (LAB_ROOT / "prompts" / "run-learning-loop.md").read_text(encoding="utf-8")
    for key, value in replacements.items():
        template = template.replace(key, value)
    print(template)
    return 0


def copy_findings(src: Path, dst: Path, force: bool) -> None:
    if dst.exists() and force:
        shutil.rmtree(dst)
    if dst.exists():
        raise SystemExit(f"Ground truth directory already exists: {dst}")
    if src.is_dir():
        shutil.copytree(src, dst)
    elif src.is_file():
        dst.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst / src.name)
    else:
        raise SystemExit(f"Findings path does not exist: {src}")


def command_init_benchmark(args: argparse.Namespace) -> int:
    name = slugify(args.name)
    repo = Path(args.repo).expanduser().resolve()
    findings = Path(args.findings).expanduser().resolve()
    if not repo.is_dir():
        print(f"Repo does not exist: {repo}", file=sys.stderr)
        return 2
    if not findings.exists():
        print(f"Findings path does not exist: {findings}", file=sys.stderr)
        return 2

    benchmark_dir = BENCHMARKS_DIR / name
    ground_truth_dir = benchmark_dir / "ground-truth"
    benchmark_dir.mkdir(parents=True, exist_ok=True)
    copy_findings(findings, ground_truth_dir, args.force)
    config = {
        "name": name,
        "repo": str(repo),
        "ground_truth_dir": str(ground_truth_dir),
        "created_at_utc": utc_now(),
        "notes": args.notes or "",
    }
    write_json(benchmark_dir / "benchmark.json", config)
    (benchmark_dir / "README.md").write_text(
        f"""# Benchmark: {name}

- Repo: `{repo}`
- Ground truth: `{ground_truth_dir}`
- Created UTC: {config["created_at_utc"]}

Ground truth files are for scoring/refinement only. Do not expose them to blind audit runs.
""",
        encoding="utf-8",
    )
    print(benchmark_dir)
    return 0


def load_benchmark(name: str) -> tuple[Path, dict]:
    benchmark_dir = BENCHMARKS_DIR / slugify(name)
    config_path = benchmark_dir / "benchmark.json"
    if not config_path.is_file():
        raise SystemExit(f"Benchmark not found: {config_path}")
    return benchmark_dir, read_json(config_path)


def scaffold_audit_run(
    source: DesignSource,
    repo: Path,
    run_name: str,
    force: bool,
    previous_ref: str | None,
    current_ref: str | None,
    parallel_jobs: int,
) -> Path:
    command = source.command
    args = [str(command), str(repo), "--run-name", run_name]
    if force:
        args.append("--force")
    if previous_ref and command_supports_flag(command, "--previous-ref"):
        args.extend(["--previous-ref", previous_ref])
    if current_ref and command_supports_flag(command, "--current-ref"):
        args.extend(["--current-ref", current_ref])
    if command_supports_flag(command, "--corpus-root"):
        args.extend(["--corpus-root", str(ROOT / "corpus" / "imports")])
    if command_supports_flag(command, "--parallel-jobs"):
        args.extend(["--parallel-jobs", str(parallel_jobs)])
    completed = subprocess.run(args, text=True, capture_output=True, check=False)
    if completed.returncode != 0:
        print(completed.stdout, end="")
        print(completed.stderr, end="", file=sys.stderr)
        raise SystemExit(completed.returncode)
    design_run = source.root / "runs" / run_name
    if not design_run.is_dir():
        raise SystemExit(f"Expected design run was not created: {design_run}")
    return design_run


def audit_option_string(
    *,
    model: str | None = None,
    timeout_seconds: int | None = None,
    skip_login_check: bool = False,
    service_tier: str | None = None,
    reasoning_effort: str | None = None,
    deep_reasoning_effort: str | None = None,
    deep_phases: str | None = None,
) -> str:
    parts: list[str] = []
    if model:
        parts.extend(["--model", model])
    if service_tier:
        parts.extend(["--service-tier", service_tier])
    if reasoning_effort:
        parts.extend(["--reasoning-effort", reasoning_effort])
    if deep_reasoning_effort:
        parts.extend(["--deep-reasoning-effort", deep_reasoning_effort])
    if deep_phases:
        parts.extend(["--deep-phases", deep_phases])
    if timeout_seconds is not None:
        parts.extend(["--timeout-seconds", str(timeout_seconds)])
    if skip_login_check:
        parts.append("--skip-login-check")
    return "".join(f" {part}" for part in parts)


def write_resume_instructions(
    round_dir: Path,
    audit_run: Path,
    runner: Path,
    parallel_jobs: int,
    *,
    model: str | None = None,
    timeout_seconds: int | None = None,
    skip_login_check: bool = False,
    service_tier: str | None = None,
    reasoning_effort: str | None = None,
    deep_reasoning_effort: str | None = None,
    deep_phases: str | None = None,
) -> None:
    option_text = audit_option_string(
        model=model,
        timeout_seconds=timeout_seconds,
        skip_login_check=skip_login_check,
        service_tier=service_tier,
        reasoning_effort=reasoning_effort,
        deep_reasoning_effort=deep_reasoning_effort,
        deep_phases=deep_phases,
    )
    (round_dir / "RESUME.md").write_text(
        f"""# Resume Interrupted Audit

The audit run was interrupted before completion, most likely because Codex quota/rate limits were exhausted.

Already completed worker prompts are checkpointed under:

```text
{audit_run / "agent-logs" / "runner-state"}
```

When limits refill, resume this same round. Do not rerun `start-round --force`, because that may replace the round directory.

Preferred command:

```bash
bin/design-lab resume-audit --round-dir {round_dir} --parallel-jobs {parallel_jobs}{option_text}
```

Lower-level runner command:

```bash
{runner} {audit_run} --jobs {parallel_jobs} --resume{option_text}
```

After the audit completes, score the round normally with `score-blind-run.md`, then run `record-result`.
""",
        encoding="utf-8",
    )


def execute_audit_for_round(
    round_dir: Path,
    source_root: Path,
    audit_run: Path,
    *,
    parallel_jobs: int,
    resume: bool,
    phase: str = "all",
    model: str | None = None,
    service_tier: str | None = None,
    reasoning_effort: str | None = None,
    deep_reasoning_effort: str | None = None,
    deep_phases: str | None = None,
    timeout_seconds: int | None = None,
    skip_login_check: bool = False,
) -> int:
    runner = resumable_runner_for_source(source_root)
    if not runner.is_file():
        print(f"Automatic execution needs a resumable runner: {runner}", file=sys.stderr)
        return 2

    command = [str(runner), str(audit_run), "--jobs", str(parallel_jobs), "--phase", phase]
    if resume:
        command.append("--resume")
    if model:
        command.extend(["--model", model])
    if service_tier:
        command.extend(["--service-tier", service_tier])
    if reasoning_effort:
        command.extend(["--reasoning-effort", reasoning_effort])
    if deep_reasoning_effort:
        command.extend(["--deep-reasoning-effort", deep_reasoning_effort])
    if deep_phases:
        command.extend(["--deep-phases", deep_phases])
    if timeout_seconds is not None:
        command.extend(["--timeout-seconds", str(timeout_seconds)])
    if skip_login_check:
        command.append("--skip-login-check")

    update_manifest(
        round_dir,
        status="audit_running",
        audit_status="running",
        audit_resume_supported=True,
        audit_runner=str(runner),
        audit_command=command,
        audit_model=model or "",
        audit_service_tier=service_tier or "",
        audit_reasoning_effort=reasoning_effort or "",
        audit_deep_reasoning_effort=deep_reasoning_effort or "",
        audit_deep_phases=deep_phases or "",
        audit_skip_login_check=skip_login_check,
        audit_started_at_utc=utc_now(),
    )
    completed = subprocess.run(command, text=True, check=False)
    if completed.returncode == 0:
        update_manifest(
            round_dir,
            status="audit_completed",
            audit_status="completed",
            audit_completed_at_utc=utc_now(),
            audit_last_returncode=0,
        )
        print(round_dir)
        return 0
    if completed.returncode == LIMIT_EXHAUSTED_EXIT_CODE:
        update_manifest(
            round_dir,
            status="limit_exhausted",
            audit_status="limit_exhausted",
            audit_last_returncode=completed.returncode,
            audit_interrupted_at_utc=utc_now(),
        )
        write_resume_instructions(
            round_dir,
            audit_run,
            runner,
            parallel_jobs,
            model=model,
            service_tier=service_tier,
            timeout_seconds=timeout_seconds,
            skip_login_check=skip_login_check,
            reasoning_effort=reasoning_effort,
            deep_reasoning_effort=deep_reasoning_effort,
            deep_phases=deep_phases,
        )
        print(f"Audit paused because Codex limits appear exhausted. Resume instructions: {round_dir / 'RESUME.md'}")
        return 0

    update_manifest(
        round_dir,
        status="audit_failed",
        audit_status="failed",
        audit_last_returncode=completed.returncode,
        audit_failed_at_utc=utc_now(),
    )
    return completed.returncode


def write_round_files(
    round_dir: Path,
    benchmark: dict,
    source: DesignSource,
    round_number: int,
    audit_run: Path,
    max_rounds: int,
) -> None:
    ground_truth_dir = Path(benchmark["ground_truth_dir"]).resolve()
    score_prompt_src = LAB_ROOT / "prompts" / "score-blind-run.md"
    refine_prompt_src = LAB_ROOT / "prompts" / "refine-design-from-misses.md"
    score_prompt = round_dir / "score-blind-run.md"
    refine_prompt = round_dir / "refine-design-from-misses.md"
    score_prompt.write_text(
        f"""# Score Blind Run: Round {round_number}

Use the scoring workflow in:
- `{score_prompt_src}`

Inputs:
- Benchmark: `{benchmark["name"]}`
- Source: {source.label}
- Source design folder: `{source.root}`
- Blind audit run: `{audit_run}`
- Ground truth findings: `{ground_truth_dir}`

Write:
- `{round_dir / "scorecard.md"}`
- `{round_dir / "misses.md"}`
- `{round_dir / "result-record.json"}`

Remember: broad family overlap is not enough. Score root-cause/mechanism equivalence.
""",
        encoding="utf-8",
    )
    refine_prompt.write_text(
        f"""# Refine Design From Misses: Round {round_number}

Use the refinement workflow in:
- `{refine_prompt_src}`

Inputs:
- Design folder: `{source.root}`
- Blind audit run: `{audit_run}`
- Scorecard: `{round_dir / "scorecard.md"}`
- Misses: `{round_dir / "misses.md"}`
- Structured result record: `{round_dir / "result-record.json"}`
- Ground truth findings: `{ground_truth_dir}`

Write:
- `{round_dir / "design-refinement-plan.md"}`

Goal:
- Improve the design generally for the missed mechanisms.
- Do not add exact historical file paths, function names, constants, or answer trails to runtime prompts.
- Inside candidate snapshots, broad edits are allowed: rewrite, delete, add, split, merge, or reorganize prompts/templates/scripts if that makes the vulnerability class more discoverable.
- If a refined candidate should be tested, propose a candidate name and list files to change inside `design-lab/runs/.../candidates/<candidate>/design/`.
""",
        encoding="utf-8",
    )
    (round_dir / "scorecard.md").write_text("# Scorecard\n\n- Status: not scored\n", encoding="utf-8")
    (round_dir / "misses.md").write_text("# Misses\n\n- Status: not analyzed\n", encoding="utf-8")
    write_json(
        round_dir / "result-record.json",
        result_record_template(benchmark, source, round_number, max_rounds, audit_run),
    )
    (round_dir / "design-refinement-plan.md").write_text(
        "# Design Refinement Plan\n\n- Status: not drafted\n",
        encoding="utf-8",
    )
    (round_dir / "ROUND.md").write_text(
        f"""# Design Lab Round {round_number}

## Benchmark

- Name: `{benchmark["name"]}`
- Repo: `{benchmark["repo"]}`
- Ground truth: `{ground_truth_dir}`

## Design

- Source: {source.label}
- Source folder: `{source.root}`
- Blind audit run: `{audit_run}`
- Round: `{round_number}` of `{max_rounds}`

## Steps

1. Run the blind audit from `{audit_run}`.
2. Score it using `{score_prompt}`.
3. Fill `{round_dir / "result-record.json"}` with the exact ground-truth findings found, partially found, and missed.
4. Record the result with `bin/design-lab record-result --round-dir {round_dir}`.
5. Analyze misses using `{refine_prompt}`.
6. Create/test the next candidate under this loop archive.

Do not expose ground truth files to the blind audit worker.
During Step 1, do not read benchmark `ground-truth/**`, `design-lab/benchmarks/**`, prior `design-lab/runs/**` scorecards, misses, result records, refinement plans, leaderboards, audit-output snapshots, candidate results, or prior round folders. Those files are only for scoring/refinement after the blind audit completes.

If Codex limits are exhausted during Step 1, do not recreate this round. Resume it after limits refill with:

```bash
bin/design-lab resume-audit --round-dir {round_dir}
```
""",
        encoding="utf-8",
    )


def command_start_round(args: argparse.Namespace) -> int:
    _, benchmark = load_benchmark(args.benchmark)
    repo = Path(benchmark["repo"]).resolve()
    source = source_from_start_args(args)

    run_slug = slugify(args.loop_name) if args.loop_name else f"{dt.datetime.now(dt.UTC):%Y%m%d-%H%M%SZ}-{benchmark['name']}-{source.name}"
    loop_dir = RUNS_DIR / run_slug
    round_label = f"round-{args.round:02d}"
    if args.trial_name:
        round_label = f"{round_label}-{slugify(args.trial_name)}"
    round_dir = loop_dir / round_label
    if round_dir.exists() and any(round_dir.iterdir()):
        if not args.force:
            print(f"Round directory already exists: {round_dir}", file=sys.stderr)
            print("Use a new --round, add --trial-name, or pass --force to overwrite it.", file=sys.stderr)
            return 2
        shutil.rmtree(round_dir)
    round_dir.mkdir(parents=True, exist_ok=True)
    audit_run_name = f"lab-{benchmark['name']}-{source.name}-{round_label}"
    audit_run = scaffold_audit_run(
        source,
        repo,
        audit_run_name,
        args.force,
        args.previous_ref,
        args.current_ref,
        args.parallel_jobs,
    )
    manifest = {
        "benchmark": benchmark["name"],
        "design_source_type": source.kind,
        "design": source.name if source.kind == "design" else "",
        "candidate": source.name if source.kind == "candidate" else "",
        "candidate_loop": source.loop_name or "",
        "source_design_dir": str(source.root),
        "round": args.round,
        "round_label": round_label,
        "trial_name": slugify(args.trial_name) if args.trial_name else "",
        "max_rounds": args.max_rounds,
        "audit_run": str(audit_run),
        "ground_truth_dir": benchmark["ground_truth_dir"],
        "audit_status": "not_started",
        "audit_resume_supported": True,
        "audit_runner": str(resumable_runner_for_source(source.root)),
        "audit_model": args.model or "",
        "audit_service_tier": args.service_tier,
        "audit_reasoning_effort": args.reasoning_effort,
        "audit_deep_reasoning_effort": args.deep_reasoning_effort,
        "audit_deep_phases": args.deep_phases,
        "audit_timeout_seconds": args.timeout_seconds,
        "audit_skip_login_check": args.skip_login_check,
        "audit_last_returncode": None,
        "created_at_utc": utc_now(),
        "status": "scaffolded",
    }
    write_json(round_dir / "round-manifest.json", manifest)
    write_round_files(round_dir, benchmark, source, args.round, audit_run, args.max_rounds)
    if args.execute_audit:
        return execute_audit_for_round(
            round_dir,
            source.root,
            audit_run,
            parallel_jobs=args.parallel_jobs,
            resume=False,
            model=args.model,
            service_tier=args.service_tier,
            reasoning_effort=args.reasoning_effort,
            deep_reasoning_effort=args.deep_reasoning_effort,
            deep_phases=args.deep_phases,
            timeout_seconds=args.timeout_seconds,
            skip_login_check=args.skip_login_check,
        )
    print(round_dir)
    return 0


def command_resume_audit(args: argparse.Namespace) -> int:
    round_dir = Path(args.round_dir).expanduser().resolve()
    manifest_path = round_dir / "round-manifest.json"
    if not manifest_path.is_file():
        print(f"Round manifest not found: {manifest_path}", file=sys.stderr)
        return 2
    manifest = read_json(manifest_path)
    audit_run = Path(manifest.get("audit_run", "")).expanduser().resolve()
    source_root = Path(manifest.get("source_design_dir", "")).expanduser().resolve()
    if not audit_run.is_dir():
        print(f"Audit run directory not found: {audit_run}", file=sys.stderr)
        return 2
    if not source_root.is_dir():
        print(f"Source design directory not found: {source_root}", file=sys.stderr)
        return 2

    model = args.model if args.model is not None else (manifest.get("audit_model") or None)
    service_tier = args.service_tier if args.service_tier is not None else (manifest.get("audit_service_tier") or None)
    reasoning_effort = args.reasoning_effort if args.reasoning_effort is not None else (
        manifest.get("audit_reasoning_effort") or None
    )
    deep_reasoning_effort = args.deep_reasoning_effort if args.deep_reasoning_effort is not None else (
        manifest.get("audit_deep_reasoning_effort") or None
    )
    deep_phases = args.deep_phases if args.deep_phases is not None else (manifest.get("audit_deep_phases") or None)
    timeout_seconds = args.timeout_seconds if args.timeout_seconds is not None else manifest.get("audit_timeout_seconds")
    skip_login_check = args.skip_login_check or bool(manifest.get("audit_skip_login_check"))

    return execute_audit_for_round(
        round_dir,
        source_root,
        audit_run,
        parallel_jobs=args.parallel_jobs,
        resume=True,
        phase=args.phase,
        model=model,
        service_tier=service_tier,
        reasoning_effort=reasoning_effort,
        deep_reasoning_effort=deep_reasoning_effort,
        deep_phases=deep_phases,
        timeout_seconds=timeout_seconds,
        skip_login_check=skip_login_check,
    )


def blind_suite_isolation_addendum(
    *,
    suite_dir: Path,
    design_name: str,
    original_design_dir: Path,
    design_root: Path,
    target: Path,
    audit_run: Path,
    corpus_root: Path,
) -> str:
    return f"""# Blind Suite Isolation Addendum

This audit is one item in a blind multi-design suite.

Allowed inputs for this item:
- Target repository: `{target}`
- Active copied design directory: `{design_root}`
- Active audit run directory: `{audit_run}`
- Shared corpus root: `{corpus_root}`
- Suite status files that contain only orchestration state under: `{suite_dir}`

Forbidden while producing this item's blind audit outputs:
- Do not read, search, summarize, or use the original design directory: `{original_design_dir}`
- Do not read any stable design run output under: `{DESIGNS_DIR / "*" / "runs"}`
- Do not read any other suite item's copied design, run directory, findings, reports, logs, or agent outputs under: `{suite_dir}`
- Do not read benchmark ground truth, known findings, scorecards, misses, result records, leaderboards, refinement plans, audit-output snapshots, candidate result archives, or prior round folders.

The current copied design and active run directory are allowed even though they live under `design-lab/runs/`. All sibling suite workspaces and previous outputs are forbidden as evidence or examples. If you accidentally see forbidden material, do not use it; record the contamination risk in `verification-log.md` and continue only from target-code evidence.

"""


def add_blind_suite_isolation_to_prompts(
    *,
    suite_dir: Path,
    design_name: str,
    original_design_dir: Path,
    design_root: Path,
    target: Path,
    audit_run: Path,
    corpus_root: Path,
) -> None:
    addendum = blind_suite_isolation_addendum(
        suite_dir=suite_dir,
        design_name=design_name,
        original_design_dir=original_design_dir,
        design_root=design_root,
        target=target,
        audit_run=audit_run,
        corpus_root=corpus_root,
    )
    prompt_dir = audit_run / "agent-prompts"
    if not prompt_dir.is_dir():
        return
    for prompt_path in sorted(prompt_dir.glob("*.md")):
        try:
            existing = prompt_path.read_text(encoding="utf-8")
        except OSError:
            continue
        if "Blind Suite Isolation Addendum" in existing:
            continue
        prompt_path.write_text(addendum + existing, encoding="utf-8")


def suite_item_dir(suite_dir: Path, index: int, design_name: str) -> Path:
    return suite_dir / "design-runs" / f"{index:02d}-{slugify(design_name)}"


def suite_design_copy_dir(suite_dir: Path, design_name: str) -> Path:
    return suite_dir / "design-workspaces" / slugify(design_name) / "design"


def suite_item_summary(item_dir: Path) -> dict:
    manifest_path = item_dir / "round-manifest.json"
    if not manifest_path.is_file():
        return {"item_dir": str(item_dir), "status": "not_started", "audit_status": "not_started"}
    manifest = read_json(manifest_path)
    return {
        "design": manifest.get("design", ""),
        "item_dir": str(item_dir),
        "design_source_dir": manifest.get("original_design_dir", ""),
        "design_copy_dir": manifest.get("source_design_dir", ""),
        "audit_run": manifest.get("audit_run", ""),
        "status": manifest.get("status", ""),
        "audit_status": manifest.get("audit_status", ""),
        "resume_command": f"bin/design-lab resume-audit --round-dir {item_dir}",
    }


def write_blind_suite_manifest(
    suite_dir: Path,
    *,
    suite_name: str,
    target: Path,
    designs: list[str],
    status: str,
    settings: dict,
    created_at_utc: str | None = None,
    message: str = "",
) -> dict:
    previous = {}
    manifest_path = suite_dir / "suite-manifest.json"
    if manifest_path.is_file():
        previous = read_json(manifest_path)
    payload = {
        "schema_version": 1,
        "kind": "blind-suite",
        "suite_name": suite_name,
        "target_repo": str(target),
        "designs": designs,
        "status": status,
        "message": message,
        "settings": settings,
        "items": [
            suite_item_summary(suite_item_dir(suite_dir, index, design))
            for index, design in enumerate(designs, start=1)
        ],
        "created_at_utc": created_at_utc or previous.get("created_at_utc") or utc_now(),
        "updated_at_utc": utc_now(),
    }
    write_json(manifest_path, payload)
    return payload


def write_blind_suite_readme(suite_dir: Path, manifest: dict) -> None:
    design_lines = "\n".join(f"- `{design}`" for design in manifest.get("designs", [])) or "- none"
    item_lines = []
    for item in manifest.get("items", []):
        item_lines.append(
            f"- `{item.get('design', '')}`: `{item.get('audit_status', '')}` at `{item.get('item_dir', '')}`"
        )
    items = "\n".join(item_lines) or "- none"
    settings_lines = "\n".join(
        f"- {key}: `{value}`" for key, value in sorted((manifest.get("settings") or {}).items())
    )
    (suite_dir / "README.md").write_text(
        f"""# Blind Design Suite: {manifest.get("suite_name", suite_dir.name)}

- Target repo: `{manifest.get("target_repo", "")}`
- Status: `{manifest.get("status", "")}`
- Updated UTC: {manifest.get("updated_at_utc", "")}

## Designs

{design_lines}

## Settings

{settings_lines}

## Items

{items}

## Resume

Resume the suite without recreating completed items:

```bash
bin/design-lab run-blind-suite --suite-name {suite_dir.name} --resume
```

Each design is copied into this suite with its old `runs/` directory excluded before execution. During an item run, workers may use only the target repository, the copied active design, the active audit run directory, and explicitly named corpus files; sibling suite outputs and stable `designs/*/runs/**` outputs are forbidden.
""",
        encoding="utf-8",
    )


def suite_settings_from_args(args: argparse.Namespace) -> dict:
    return {
        "parallel_jobs": args.parallel_jobs,
        "model": args.model or "",
        "service_tier": args.service_tier,
        "reasoning_effort": args.reasoning_effort,
        "deep_reasoning_effort": args.deep_reasoning_effort,
        "deep_phases": args.deep_phases,
        "timeout_seconds": args.timeout_seconds,
        "skip_login_check": args.skip_login_check,
        "previous_ref": args.previous_ref or "",
        "current_ref": args.current_ref or "",
    }


def load_blind_suite_args(args: argparse.Namespace) -> tuple[str, Path, list[str], dict]:
    if args.resume and not args.suite_name:
        raise SystemExit("--suite-name is required with --resume")
    if args.resume and args.force:
        raise SystemExit("--resume and --force cannot be used together")
    suite_slug = slugify(args.suite_name) if args.suite_name else ""
    manifest_path = RUNS_DIR / suite_slug / "suite-manifest.json" if suite_slug else None
    previous_manifest = read_json(manifest_path) if manifest_path and manifest_path.is_file() else {}
    if args.resume and not previous_manifest:
        raise SystemExit(f"Blind suite manifest not found: {manifest_path}")

    target_value = args.repo or previous_manifest.get("target_repo")
    if not target_value:
        raise SystemExit("--repo is required for a new blind suite")
    target = Path(str(target_value)).expanduser().resolve()
    if not target.is_dir():
        raise SystemExit(f"Target repo does not exist: {target}")

    designs = [slugify(design) for design in (args.design or previous_manifest.get("designs") or [])]
    if not designs:
        raise SystemExit("--design is required for a new blind suite; repeat it once per design")
    if len(set(designs)) != len(designs):
        raise SystemExit("Blind suite design names must be unique")
    if args.resume and args.design and designs != previous_manifest.get("designs"):
        raise SystemExit("Resume must use the design list recorded in the existing suite manifest")

    if not suite_slug:
        suite_slug = f"{dt.datetime.now(dt.UTC):%Y%m%d-%H%M%SZ}-{slugify(target.name)}-blind-suite"

    settings = previous_manifest.get("settings") if args.resume and previous_manifest else None
    if not isinstance(settings, dict):
        settings = suite_settings_from_args(args)
    return suite_slug, target, designs, settings


def scaffold_blind_suite_item(
    *,
    suite_dir: Path,
    index: int,
    design_name: str,
    target: Path,
    settings: dict,
    force: bool,
) -> tuple[Path, Path, Path]:
    original_source = load_design_source(design_name)
    item_dir = suite_item_dir(suite_dir, index, design_name)
    design_copy = suite_design_copy_dir(suite_dir, design_name)
    if item_dir.exists() and any(item_dir.iterdir()) and not force:
        raise SystemExit(f"Suite item already exists: {item_dir}")
    if item_dir.exists() and force:
        shutil.rmtree(item_dir)
    if design_copy.exists() and force:
        shutil.rmtree(design_copy.parent)
    if not design_copy.is_dir():
        copy_design_tree(original_source.root, design_copy, False)

    item_dir.mkdir(parents=True, exist_ok=True)
    suite_source = load_suite_design_source(design_copy, design_name)
    run_name = f"suite-{suite_dir.name}-{index:02d}-{slugify(design_name)}"
    audit_run = scaffold_audit_run(
        suite_source,
        target,
        run_name,
        force,
        str(settings.get("previous_ref") or "") or None,
        str(settings.get("current_ref") or "") or None,
        int(settings.get("parallel_jobs") or 8),
    )
    corpus_root = ROOT / "corpus" / "imports"
    add_blind_suite_isolation_to_prompts(
        suite_dir=suite_dir,
        design_name=design_name,
        original_design_dir=original_source.root,
        design_root=design_copy,
        target=target,
        audit_run=audit_run,
        corpus_root=corpus_root,
    )
    manifest = {
        "schema_version": 1,
        "kind": "blind-suite-item",
        "suite_name": suite_dir.name,
        "repo": str(target),
        "design_source_type": "design",
        "design": design_name,
        "original_design_dir": str(original_source.root),
        "source_design_dir": str(design_copy.resolve()),
        "round": index,
        "round_label": f"suite-{index:02d}-{design_name}",
        "trial_name": "",
        "audit_run": str(audit_run),
        "audit_status": "not_started",
        "audit_resume_supported": True,
        "audit_runner": str(resumable_runner_for_source(design_copy)),
        "audit_model": str(settings.get("model") or ""),
        "audit_service_tier": str(settings.get("service_tier") or DEFAULT_SERVICE_TIER),
        "audit_reasoning_effort": str(settings.get("reasoning_effort") or DEFAULT_REASONING_EFFORT),
        "audit_deep_reasoning_effort": str(
            settings.get("deep_reasoning_effort") or DEFAULT_DEEP_REASONING_EFFORT
        ),
        "audit_deep_phases": str(settings.get("deep_phases") or DEFAULT_DEEP_PHASES),
        "audit_timeout_seconds": settings.get("timeout_seconds"),
        "audit_skip_login_check": bool(settings.get("skip_login_check")),
        "audit_last_returncode": None,
        "blind_suite_isolation": {
            "allowed_target_repo": str(target),
            "allowed_design_copy": str(design_copy.resolve()),
            "allowed_audit_run": str(audit_run),
            "forbidden_original_design_dir": str(original_source.root),
            "forbidden_stable_design_runs": str(DESIGNS_DIR / "*" / "runs"),
            "forbidden_sibling_suite_outputs": str(suite_dir),
        },
        "created_at_utc": utc_now(),
        "status": "scaffolded",
    }
    write_json(item_dir / "round-manifest.json", manifest)
    (item_dir / "RUN.md").write_text(
        f"""# Blind Suite Item: {design_name}

- Suite: `{suite_dir}`
- Target repo: `{target}`
- Original design: `{original_source.root}`
- Copied design: `{design_copy.resolve()}`
- Active audit run: `{audit_run}`

This item is isolated from prior suite results. Do not read sibling suite workspaces or stable `designs/*/runs/**` output while producing findings.

Resume this item directly if needed:

```bash
bin/design-lab resume-audit --round-dir {item_dir}
```
""",
        encoding="utf-8",
    )
    return item_dir, design_copy, audit_run


def command_run_blind_suite(args: argparse.Namespace) -> int:
    suite_slug, target, designs, settings = load_blind_suite_args(args)
    suite_dir = RUNS_DIR / suite_slug
    if suite_dir.exists() and not args.resume:
        if not args.force:
            print(f"Blind suite already exists: {suite_dir}", file=sys.stderr)
            print("Use --resume to continue it or --force to replace it.", file=sys.stderr)
            return 2
        shutil.rmtree(suite_dir)
    suite_dir.mkdir(parents=True, exist_ok=True)

    created_at = None if args.resume else utc_now()
    manifest = write_blind_suite_manifest(
        suite_dir,
        suite_name=suite_slug,
        target=target,
        designs=designs,
        status="running",
        settings=settings,
        created_at_utc=created_at,
    )
    write_blind_suite_readme(suite_dir, manifest)

    for index, design_name in enumerate(designs, start=1):
        item_dir = suite_item_dir(suite_dir, index, design_name)
        item_manifest_path = item_dir / "round-manifest.json"
        if item_manifest_path.is_file():
            item_manifest = read_json(item_manifest_path)
            audit_status = item_manifest.get("audit_status")
            if audit_status == "completed":
                manifest = write_blind_suite_manifest(
                    suite_dir,
                    suite_name=suite_slug,
                    target=target,
                    designs=designs,
                    status="running",
                    settings=settings,
                    message=f"Skipped completed design `{design_name}`.",
                )
                write_blind_suite_readme(suite_dir, manifest)
                continue
            if not args.resume and not args.force:
                print(f"Suite item already exists: {item_dir}", file=sys.stderr)
                return 2
            audit_run = Path(str(item_manifest.get("audit_run", ""))).expanduser().resolve()
            design_copy = Path(str(item_manifest.get("source_design_dir", ""))).expanduser().resolve()
        else:
            item_dir, design_copy, audit_run = scaffold_blind_suite_item(
                suite_dir=suite_dir,
                index=index,
                design_name=design_name,
                target=target,
                settings=settings,
                force=args.force,
            )

        if args.scaffold_only:
            manifest = write_blind_suite_manifest(
                suite_dir,
                suite_name=suite_slug,
                target=target,
                designs=designs,
                status="scaffolded",
                settings=settings,
                message="Suite scaffolded without execution.",
            )
            write_blind_suite_readme(suite_dir, manifest)
            continue

        resume_item = args.resume and item_manifest_path.is_file()
        result = execute_audit_for_round(
            item_dir,
            design_copy,
            audit_run,
            parallel_jobs=int(settings.get("parallel_jobs") or 8),
            resume=resume_item,
            phase=args.phase,
            model=str(settings.get("model") or "") or None,
            service_tier=str(settings.get("service_tier") or DEFAULT_SERVICE_TIER),
            reasoning_effort=str(settings.get("reasoning_effort") or DEFAULT_REASONING_EFFORT),
            deep_reasoning_effort=str(settings.get("deep_reasoning_effort") or DEFAULT_DEEP_REASONING_EFFORT),
            deep_phases=str(settings.get("deep_phases") or DEFAULT_DEEP_PHASES),
            timeout_seconds=settings.get("timeout_seconds"),
            skip_login_check=bool(settings.get("skip_login_check")),
        )
        item_manifest = read_json(item_manifest_path)
        if item_manifest.get("audit_status") == "limit_exhausted":
            manifest = write_blind_suite_manifest(
                suite_dir,
                suite_name=suite_slug,
                target=target,
                designs=designs,
                status="limit_exhausted",
                settings=settings,
                message=f"Paused while running `{design_name}`. Resume with --resume.",
            )
            write_blind_suite_readme(suite_dir, manifest)
            print(f"Blind suite paused because Codex limits appear exhausted: {suite_dir / 'README.md'}")
            return 0
        if result != 0 or item_manifest.get("audit_status") == "failed":
            manifest = write_blind_suite_manifest(
                suite_dir,
                suite_name=suite_slug,
                target=target,
                designs=designs,
                status="failed",
                settings=settings,
                message=f"Stopped after `{design_name}` failed.",
            )
            write_blind_suite_readme(suite_dir, manifest)
            return result or int(item_manifest.get("audit_last_returncode") or 1)

        manifest = write_blind_suite_manifest(
            suite_dir,
            suite_name=suite_slug,
            target=target,
            designs=designs,
            status="running",
            settings=settings,
            message=f"Completed `{design_name}`.",
        )
        write_blind_suite_readme(suite_dir, manifest)

    final_status = "scaffolded" if args.scaffold_only else "completed"
    manifest = write_blind_suite_manifest(
        suite_dir,
        suite_name=suite_slug,
        target=target,
        designs=designs,
        status=final_status,
        settings=settings,
        message="Blind suite completed." if not args.scaffold_only else "Blind suite scaffolded.",
    )
    write_blind_suite_readme(suite_dir, manifest)
    print(suite_dir)
    return 0


def command_create_candidate(args: argparse.Namespace) -> int:
    loop_name = slugify(args.loop_name)
    name = slugify(args.candidate)
    destination = candidate_dir(loop_name, name)
    design_destination = destination / "design"

    if args.source_design:
        source = DESIGNS_DIR / slugify(args.source_design)
        source_type = "design"
        source_name = slugify(args.source_design)
    else:
        source_candidate = slugify(args.source_candidate)
        source = candidate_dir(loop_name, source_candidate) / "design"
        source_type = "candidate"
        source_name = source_candidate

    if not source.is_dir():
        print(f"Source design folder not found: {source}", file=sys.stderr)
        return 2

    if destination.exists() and args.force:
        shutil.rmtree(destination)
    if destination.exists():
        print(f"Candidate already exists: {destination}", file=sys.stderr)
        return 2

    copy_design_tree(source, design_destination, False)
    metadata = {
        "name": name,
        "loop_name": loop_name,
        "source_type": source_type,
        "source_name": source_name,
        "source_design_dir": str(source.resolve()),
        "candidate_design_dir": str(design_destination.resolve()),
        "created_at_utc": utc_now(),
        "notes": args.notes or "",
        "status": "created",
    }
    write_json(destination / "candidate.json", metadata)
    (destination / "README.md").write_text(
        f"""# Candidate: {name}

- Loop: `{loop_name}`
- Source: `{source_type}` `{source_name}`
- Design snapshot: `{design_destination.resolve()}`
- Created UTC: {metadata["created_at_utc"]}

Edit this candidate's prompt/design files here. You may rewrite, delete, add, split, merge, or reorganize prompts/templates/scripts as long as the design remains runnable and the changes target general vulnerability classes rather than benchmark-specific answer paths.

Do not copy every experiment into `designs/`; only promote the best scored candidate.
""",
        encoding="utf-8",
    )
    print(design_destination)
    return 0


def snapshot_audit_output(round_dir: Path, audit_run: Path, force: bool) -> Path | None:
    if not audit_run.is_dir():
        return None
    destination = round_dir / "audit-output-snapshot"
    if destination.exists():
        if not force:
            return destination
        shutil.rmtree(destination)
    shutil.copytree(audit_run, destination, ignore=design_ignore)
    return destination


def archive_result_for_source(round_dir: Path, manifest: dict, result_record: dict) -> None:
    source_type = manifest.get("design_source_type") or "design"
    round_label = manifest.get("round_label") or f"round-{int(manifest.get('round', 0)):02d}"
    round_name = f"{manifest.get('benchmark', 'benchmark')}-{round_label}"
    if source_type == "candidate":
        candidate_loop = manifest.get("candidate_loop")
        candidate_name = manifest.get("candidate")
        if not candidate_loop or not candidate_name:
            return
        archive_dir = candidate_dir(candidate_loop, candidate_name) / "results" / round_name
    else:
        loop_dir = round_dir.parent
        design_name = manifest.get("design") or "design"
        archive_dir = loop_dir / "results" / f"{design_name}-{round_name}"

    archive_dir.mkdir(parents=True, exist_ok=True)
    for name in (
        "round-manifest.json",
        "scorecard.md",
        "misses.md",
        "design-refinement-plan.md",
        "result-record.json",
    ):
        src = round_dir / name
        if src.is_file():
            shutil.copy2(src, archive_dir / name)
    write_json(archive_dir / "result-pointer.json", result_record)


def write_leaderboard(loop_dir: Path) -> Path:
    rows: list[tuple[float, int, int, int, Path, dict]] = []
    for result_path in sorted(loop_dir.glob("round-*/result-record.json")):
        try:
            record = normalize_result_record(read_json(result_path))
        except (OSError, json.JSONDecodeError):
            continue
        score = record.get("score")
        if score is None:
            continue
        try:
            score_value = float(score)
        except (TypeError, ValueError):
            continue
        rows.append(
            (
                score_value,
                int(record.get("found_count") or 0),
                int(record.get("partial_count") or 0),
                -int(record.get("missed_count") or 0),
                result_path,
                record,
            )
        )

    rows.sort(key=lambda row: (row[0], row[1], row[2], row[3], str(row[4])), reverse=True)
    lines = [
        "# Design Lab Leaderboard",
        "",
        f"- Loop: `{loop_dir.name}`",
        f"- Updated UTC: {utc_now()}",
        "",
        "| Rank | Score | Source | Round | Found | Partial | Missed | Found IDs | Result |",
        "| --- | ---: | --- | ---: | ---: | ---: | ---: | --- | --- |",
    ]
    for index, (score, found, partial, neg_missed, result_path, record) in enumerate(rows, start=1):
        source = record.get("candidate_name") or record.get("design_name") or record.get("source_design_dir", "")
        found_ids = ", ".join(entry_ids(record.get("found_findings"))) or "-"
        round_number = record.get("round", "")
        lines.append(
            f"| {index} | {score:.4g} | `{source}` | {round_number} | {found} | {partial} | {-neg_missed} | {found_ids} | `{result_path}` |"
        )
    if not rows:
        lines.append("| - | - | - | - | - | - | - | - | - |")
    path = loop_dir / "leaderboard.md"
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return path


def command_record_result(args: argparse.Namespace) -> int:
    round_dir = Path(args.round_dir).expanduser().resolve()
    manifest_path = round_dir / "round-manifest.json"
    if not manifest_path.is_file():
        print(f"Round manifest not found: {manifest_path}", file=sys.stderr)
        return 2
    manifest = read_json(manifest_path)

    result_path = round_dir / "result-record.json"
    if args.result_json:
        record = read_json(Path(args.result_json).expanduser().resolve())
    elif result_path.is_file():
        record = read_json(result_path)
    else:
        record = {}

    record.setdefault("schema_version", 1)
    record.setdefault("benchmark", manifest.get("benchmark", ""))
    record.setdefault("round", manifest.get("round", 0))
    record.setdefault("round_label", manifest.get("round_label", ""))
    record.setdefault("trial_name", manifest.get("trial_name", ""))
    record.setdefault("design_source_type", manifest.get("design_source_type", "design"))
    record.setdefault("design_name", manifest.get("design", ""))
    record.setdefault("candidate_name", manifest.get("candidate", ""))
    record.setdefault("candidate_loop", manifest.get("candidate_loop", ""))
    record.setdefault("source_design_dir", manifest.get("source_design_dir", ""))
    record.setdefault("audit_run", manifest.get("audit_run", ""))
    record.setdefault("ground_truth_dir", manifest.get("ground_truth_dir", ""))

    if args.score is not None:
        record["score"] = args.score
    if args.known_total is not None:
        record["known_findings_total"] = args.known_total
    if args.found:
        record["found_findings"] = result_entries(args.found, "found")
    if args.partial:
        record["partial_findings"] = result_entries(args.partial, "partial")
    if args.missed:
        record["missed_findings"] = result_entries(args.missed, "missed")
    if args.false_positive:
        record["false_positives"] = [
            {
                "audit_candidate_id": value,
                "title": "",
                "reason": "",
                "notes": "",
            }
            for value in args.false_positive
        ]

    record["recorded_at_utc"] = utc_now()
    record = normalize_result_record(record)
    write_json(result_path, record)

    snapshot_path = None
    if not args.no_snapshot:
        snapshot_path = snapshot_audit_output(round_dir, Path(manifest.get("audit_run", "")), args.force)
        if snapshot_path:
            record["audit_output_snapshot"] = str(snapshot_path)
            write_json(result_path, record)

    archive_result_for_source(round_dir, manifest, record)
    leaderboard_path = write_leaderboard(round_dir.parent)
    print(result_path)
    print(leaderboard_path)
    return 0


def select_best_result(loop_dir: Path) -> tuple[Path, dict]:
    best: tuple[float, int, int, int, Path, dict] | None = None
    for result_path in sorted(loop_dir.glob("round-*/result-record.json")):
        try:
            record = normalize_result_record(read_json(result_path))
            score = float(record["score"])
        except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError):
            continue
        candidate = (
            score,
            int(record.get("found_count") or 0),
            int(record.get("partial_count") or 0),
            -int(record.get("missed_count") or 0),
            result_path,
            record,
        )
        if best is None or candidate[:4] > best[:4]:
            best = candidate
    if best is None:
        raise SystemExit(f"No scored result records found under: {loop_dir}")
    return best[4], best[5]


def command_leaderboard(args: argparse.Namespace) -> int:
    loop_dir = RUNS_DIR / slugify(args.loop_name)
    if not loop_dir.is_dir():
        print(f"Loop not found: {loop_dir}", file=sys.stderr)
        return 2
    print(write_leaderboard(loop_dir))
    return 0


def command_promote_best(args: argparse.Namespace) -> int:
    loop_dir = RUNS_DIR / slugify(args.loop_name)
    if not loop_dir.is_dir():
        print(f"Loop not found: {loop_dir}", file=sys.stderr)
        return 2
    result_path, record = select_best_result(loop_dir)
    source = Path(record.get("source_design_dir", "")).expanduser().resolve()
    if not source.is_dir():
        print(f"Best result source design folder not found: {source}", file=sys.stderr)
        return 2

    destination = DESIGNS_DIR / slugify(args.new_design)
    copy_design_tree(source, destination, args.force)
    write_json(destination / "BEST_RESULT.json", record)
    found_ids = ", ".join(entry_ids(record.get("found_findings"))) or "-"
    partial_ids = ", ".join(entry_ids(record.get("partial_findings"))) or "-"
    missed_ids = ", ".join(entry_ids(record.get("missed_findings"))) or "-"
    (destination / "PROMOTION.md").write_text(
        f"""# Promoted Best Design: {destination.name}

- Loop: `{loop_dir}`
- Best result: `{result_path}`
- Source design snapshot: `{source}`
- Score: `{record.get("score")}`
- Found findings: {found_ids}
- Partial findings: {partial_ids}
- Missed findings: {missed_ids}
- Promoted UTC: {utc_now()}

This design was copied from the best scored candidate/source in the loop. Other candidates remain archived under `design-lab/runs/{loop_dir.name}/`.
""",
        encoding="utf-8",
    )
    write_leaderboard(loop_dir)
    print(destination)
    return 0


def command_promote_design(args: argparse.Namespace) -> int:
    source = DESIGNS_DIR / args.source_design
    destination = DESIGNS_DIR / slugify(args.new_design)
    if not source.is_dir():
        print(f"Source design not found: {source}", file=sys.stderr)
        return 2
    copy_design_tree(source, destination, args.force)
    from_round = Path(args.from_round).expanduser().resolve() if args.from_round else None
    promotion_note = [
        f"# Promoted Design: {destination.name}",
        "",
        f"- Source design: `{source}`",
        f"- Promoted UTC: {utc_now()}",
    ]
    if from_round:
        promotion_note.append(f"- Source round: `{from_round}`")
        promotion_note.append(f"- Scorecard: `{from_round / 'scorecard.md'}`")
        promotion_note.append(f"- Refinement plan: `{from_round / 'design-refinement-plan.md'}`")
    promotion_note.extend(
        [
            "",
            "Review the copied design and apply the approved general changes from the refinement plan.",
            "Do not add benchmark-specific answer paths to runtime prompts.",
        ]
    )
    (destination / "PROMOTION.md").write_text("\n".join(promotion_note) + "\n", encoding="utf-8")
    print(destination)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    init = subparsers.add_parser("init-benchmark", help="Register a previous competition benchmark.")
    init.add_argument("--name", required=True)
    init.add_argument("--repo", required=True)
    init.add_argument("--findings", required=True)
    init.add_argument("--notes")
    init.add_argument("--force", action="store_true")
    init.set_defaults(func=command_init_benchmark)

    loop_prompt = subparsers.add_parser("learning-loop-prompt", help="Render a ready-to-paste learning-loop prompt.")
    loop_prompt.add_argument("--repo", help="Competition repository path. Optional; omitted values remain placeholders.")
    loop_prompt.add_argument("--findings", help="Known findings file or directory. Optional; omitted values remain placeholders.")
    loop_prompt.add_argument("--benchmark", help="Benchmark name. Defaults to the repo directory name when --repo is provided.")
    loop_prompt.add_argument("--loop-name")
    loop_prompt.add_argument("--starting-design", default="corpus-search")
    loop_prompt.add_argument("--max-rounds", type=int, default=5)
    loop_prompt.add_argument("--parallel-jobs", type=int, default=8)
    loop_prompt.add_argument("--service-tier", choices=SERVICE_TIER_CHOICES, default=DEFAULT_SERVICE_TIER)
    loop_prompt.add_argument("--reasoning-effort", choices=REASONING_EFFORT_CHOICES, default=DEFAULT_REASONING_EFFORT)
    loop_prompt.add_argument(
        "--deep-reasoning-effort",
        choices=REASONING_EFFORT_CHOICES,
        default=DEFAULT_DEEP_REASONING_EFFORT,
    )
    loop_prompt.add_argument("--deep-phases", default=DEFAULT_DEEP_PHASES)
    loop_prompt.add_argument("--promoted-design")
    loop_prompt.set_defaults(func=command_learning_loop_prompt)

    create = subparsers.add_parser("create-candidate", help="Archive a prompt/design candidate under a lab loop.")
    create.add_argument("--loop-name", required=True)
    create.add_argument("--candidate", required=True, help="Candidate name under design-lab/runs/<loop>/candidates/.")
    source_group = create.add_mutually_exclusive_group(required=True)
    source_group.add_argument("--source-design", help="Copy from a design folder under designs/.")
    source_group.add_argument("--source-candidate", help="Copy from another candidate in the same loop.")
    create.add_argument("--notes")
    create.add_argument("--force", action="store_true")
    create.set_defaults(func=command_create_candidate)

    start = subparsers.add_parser("start-round", help="Scaffold one blind audit/eval/refinement round.")
    start.add_argument("--benchmark", required=True)
    start_source = start.add_mutually_exclusive_group(required=True)
    start_source.add_argument("--design", help="Design folder name under designs/.")
    start_source.add_argument("--candidate", help="Candidate name under design-lab/runs/<loop-name>/candidates/.")
    start.add_argument("--round", type=int, default=1)
    start.add_argument("--trial-name", help="Optional suffix for testing multiple candidates in the same round.")
    start.add_argument("--max-rounds", type=int, default=5)
    start.add_argument("--loop-name", help="Stable lab run folder name under design-lab/runs/.")
    start.add_argument("--previous-ref")
    start.add_argument("--current-ref")
    start.add_argument("--parallel-jobs", type=int, default=8)
    start.add_argument("--model")
    start.add_argument("--service-tier", choices=SERVICE_TIER_CHOICES, default=DEFAULT_SERVICE_TIER)
    start.add_argument("--timeout-seconds", type=int)
    start.add_argument("--skip-login-check", action="store_true")
    start.add_argument("--reasoning-effort", choices=REASONING_EFFORT_CHOICES, default=DEFAULT_REASONING_EFFORT)
    start.add_argument(
        "--deep-reasoning-effort",
        choices=REASONING_EFFORT_CHOICES,
        default=DEFAULT_DEEP_REASONING_EFFORT,
    )
    start.add_argument("--deep-phases", default=DEFAULT_DEEP_PHASES)
    start.add_argument("--execute-audit", action="store_true")
    start.add_argument("--force", action="store_true")
    start.set_defaults(func=command_start_round)

    suite = subparsers.add_parser(
        "run-blind-suite",
        help="Run multiple stable designs sequentially with blind audit settings and isolated workspaces.",
    )
    suite.add_argument("--repo", help="Target repository path. Required for a new suite.")
    suite.add_argument(
        "--design",
        action="append",
        help="Stable design folder name under designs/. Repeat once per design. Required for a new suite.",
    )
    suite.add_argument("--suite-name", help="Stable folder name under design-lab/runs/.")
    suite.add_argument("--previous-ref")
    suite.add_argument("--current-ref")
    suite.add_argument("--parallel-jobs", type=int, default=8)
    suite.add_argument("--model")
    suite.add_argument("--service-tier", choices=SERVICE_TIER_CHOICES, default=DEFAULT_SERVICE_TIER)
    suite.add_argument("--timeout-seconds", type=int)
    suite.add_argument("--skip-login-check", action="store_true")
    suite.add_argument("--reasoning-effort", choices=REASONING_EFFORT_CHOICES, default=DEFAULT_REASONING_EFFORT)
    suite.add_argument(
        "--deep-reasoning-effort",
        choices=REASONING_EFFORT_CHOICES,
        default=DEFAULT_DEEP_REASONING_EFFORT,
    )
    suite.add_argument("--deep-phases", default=DEFAULT_DEEP_PHASES)
    suite.add_argument("--phase", choices=RUNNER_PHASE_CHOICES, default="all")
    suite.add_argument("--resume", action="store_true", help="Continue an existing suite and skip completed designs.")
    suite.add_argument("--scaffold-only", action="store_true", help="Create isolated design runs without launching Codex.")
    suite.add_argument("--force", action="store_true", help="Replace an existing suite when not using --resume.")
    suite.set_defaults(func=command_run_blind_suite)

    resume = subparsers.add_parser("resume-audit", help="Resume an interrupted round audit without recreating it.")
    resume.add_argument("--round-dir", required=True)
    resume.add_argument("--parallel-jobs", type=int, default=8)
    resume.add_argument("--phase", choices=RUNNER_PHASE_CHOICES, default="all")
    resume.add_argument("--model")
    resume.add_argument("--service-tier", choices=SERVICE_TIER_CHOICES)
    resume.add_argument("--timeout-seconds", type=int)
    resume.add_argument("--skip-login-check", action="store_true")
    resume.add_argument("--reasoning-effort", choices=REASONING_EFFORT_CHOICES)
    resume.add_argument("--deep-reasoning-effort", choices=REASONING_EFFORT_CHOICES)
    resume.add_argument("--deep-phases")
    resume.set_defaults(func=command_resume_audit)

    record = subparsers.add_parser("record-result", help="Record exact found/missed findings for a completed round.")
    record.add_argument("--round-dir", required=True)
    record.add_argument("--result-json", help="Optional structured result record to copy into the round.")
    record.add_argument("--score", type=float, help="Comparable score for leaderboard selection.")
    record.add_argument("--known-total", type=int)
    record.add_argument("--found", action="append", help="Ground-truth finding id that the audit found. Repeatable.")
    record.add_argument("--partial", action="append", help="Ground-truth finding id that was partially found. Repeatable.")
    record.add_argument("--missed", action="append", help="Ground-truth finding id that was missed. Repeatable.")
    record.add_argument("--false-positive", action="append", help="Audit candidate id judged false-positive. Repeatable.")
    record.add_argument("--no-snapshot", action="store_true", help="Do not copy the audit run output into the round archive.")
    record.add_argument("--force", action="store_true")
    record.set_defaults(func=command_record_result)

    leaderboard = subparsers.add_parser("leaderboard", help="Write a leaderboard for scored rounds in one loop.")
    leaderboard.add_argument("--loop-name", required=True)
    leaderboard.set_defaults(func=command_leaderboard)

    promote_best = subparsers.add_parser("promote-best", help="Promote only the best scored candidate/source into designs/.")
    promote_best.add_argument("--loop-name", required=True)
    promote_best.add_argument("--new-design", required=True)
    promote_best.add_argument("--force", action="store_true")
    promote_best.set_defaults(func=command_promote_best)

    promote = subparsers.add_parser("promote-design", help="Copy a reviewed design into a new designs/ folder.")
    promote.add_argument("--source-design", required=True)
    promote.add_argument("--new-design", required=True)
    promote.add_argument("--from-round")
    promote.add_argument("--force", action="store_true")
    promote.set_defaults(func=command_promote_design)
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
